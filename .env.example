# ShortForge Environment Configuration Example

# Database & Redis
DATABASE_URL=postgresql+asyncpg://shortforge:shortforge_pass@postgres:5432/shortforge
REDIS_URL=redis://redis:6379/0

# Directory Paths
INPUT_DIR=./input
PROCESSING_DIR=./processing
OUTPUT_DIR=./output
ARCHIVE_DIR=./archive
LOGS_DIR=./logs
FONTS_DIR=./fonts

# Default Video Transcoding Settings
DEFAULT_CLIP_LENGTH=90
DEFAULT_VIDEO_CODEC=h264
TELEGRAM_BOT_TOKEN=8857789104:AAEIMVnt6Loea1zSUgcnPuOBDJejn8RC48A
DEFAULT_AUDIO_CODEC=aac
DEFAULT_BITRATE=6M
DEFAULT_FPS=30
DEFAULT_RESOLUTION=1080x1920

# Text Overlay Defaults
DEFAULT_OVERLAY_FONT=DejaVuSans-Bold.ttf
DEFAULT_OVERLAY_SIZE=54
DEFAULT_OVERLAY_COLOR=white
DEFAULT_OVERLAY_OUTLINE_COLOR=black
DEFAULT_OVERLAY_OUTLINE_WIDTH=4
DEFAULT_TOP_PADDING=120

# System Safety
SAFE_DISK_FREE_GB=5.0
MAX_WORKERS=0 # 0 for auto-tuning based on available CPU threads
